{
  "name": "website-destroyer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "WEBSITE DESTROYER – side-scrolling 2D arcade game (Phaser 3 + TypeScript) on Cloudflare Workers + Browser Rendering + D1.",
  "scripts": {
    "build:engine": "esbuild engine/src/index.ts --bundle --format=iife --global-name=WDEngine --target=es2020 --minify --sourcemap --outfile=public/assets/wd-engine.js",
    "vendor:phaser": "node scripts/vendor-phaser.mjs",
    "build": "npm run build:engine && npm run vendor:phaser",
    "postinstall": "node scripts/vendor-phaser.mjs",
    "typecheck": "tsc -p engine/tsconfig.json",
    "dev": "npm run build && wrangler dev --remote",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create website-destroyer",
    "db:migrate": "wrangler d1 migrations apply website-destroyer --remote",
    "db:migrate:local": "wrangler d1 migrations apply website-destroyer --local",
    "test": "npm run test:engine && npm run test:worker",
    "test:engine": "tsx --test engine/test/*.test.ts",
    "test:worker": "node --test --no-warnings \"test/*.test.mjs\""
  },
  "dependencies": { "@cloudflare/puppeteer": "latest", "phaser": "^3.80.1" },
  "devDependencies": { "wrangler": "latest", "esbuild": "latest", "typescript": "latest", "tsx": "latest", "@types/node": "latest" },
  "engines": { "node": ">=20" }
}
